{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirror Windows",
  "version": "0.2.0",
  "identifier": "dev.codex.mirrorwindows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\tauri-dev.ps1",
    "beforeBuildCommand": "cmd /c npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mirror Windows",
        "width": 1440,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Haha Studio",
    "copyright": "Copyright (c) 2026 Haha Studio. All rights reserved.",
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}